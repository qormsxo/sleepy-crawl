# PostgreSQL. 다른 앱과 같은 DB를 써도 된다: 모든 객체는 "sleepy" 스키마에만 만든다.
# ?schema= 를 붙이면 반드시 sleepy 여야 한다.
DATABASE_URL=postgresql://postgres:password@localhost:5432/your_db?schema=sleepy
# LLM: gemini | openai | fake (fake = 로컬 데모용 결정적 평가, 외부 호출 없음)
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=60000
NODE_ENV=development

# 제보 봇 확인(Cloudflare Turnstile). 개발에서 비우면 Cloudflare 테스트 키(항상 통과)를 씀.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 제보자 IP 해시용 솔트(운영 필수)
IP_HASH_SALT=
